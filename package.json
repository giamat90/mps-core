    "./zoomPan": "./src/lib/zoomPan.ts",
    "./music": "./src/lib/music.ts",
    "./pitch": "./src/lib/pitch.ts",
    "./pack": "./src/pack/index.ts",
    "./spectrum": "./src/spectrum/index.ts",
    "./updater": "./src/updater/index.ts",
    "./lyrics": "./src/lyrics/index.ts",
    "./panels": "./src/panels/index.ts",
    "./windows": "./src/windows/index.ts",
    "./takes": "./src/takes/index.ts",
    "./shortcuts": "./src/shortcuts/index.ts",
    "./loops": "./src/loops/index.ts",
    "./youtube": "./src/youtube/index.ts"
